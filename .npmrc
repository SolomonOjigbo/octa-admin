# react-scripts 5 peer-depends on typescript ^3||^4; this repo is on TS 5.
# Same conflict and same fix as octa-frontend: without this, a clean `npm ci`
# (CI, Vercel) hard-fails on ERESOLVE while local installs made with
# --legacy-peer-deps pass — the split that left octa-web's lint gate red on
# every run for weeks. Committed so all environments resolve identically.
legacy-peer-deps=true
